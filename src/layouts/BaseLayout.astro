---
import "../styles/global.css";

const {
    title = "scy28的个人网站",
    description = "个人项目、技术笔记与学习记录",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
    </head>

    <body>
        <header class="site-header">
            <nav class="nav">
                <a class="logo" href="/">scy28</a>

                <div class="nav-links">
                    <a href="/">首页</a>
                    <a href="/about">关于我</a>
                    <a href="/projects">项目</a>
                    <a href="/notes">笔记</a>
                </div>
            </nav>
        </header>

        <main class="container">
            <slot />
        </main>

        <footer class="site-footer">
            © 2026 scy28 · 个人网站 / 技术笔记 / 项目作品集
        </footer>
    </body>
</html>
